APP_NAME=EventSourcedLedger
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=ledger
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Ledger
LEDGER_SNAPSHOT_EVERY=50
LEDGER_COMMAND_MAX_ATTEMPTS=3
LEDGER_SYNC_PROJECTIONS=true
LEDGER_OUTBOX_PUBLISHER=log
LEDGER_OUTBOX_MAX_ATTEMPTS=10
LEDGER_IDEMPOTENCY_TTL_HOURS=24
